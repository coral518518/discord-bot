# 1. 运行模式选择 (必填/选填，默认 singbox)
#   - singbox (或 sb, argo): 运行 Sing-box 多协议版 (支持 VLESS/VMess/Trojan/Hy2/TUIC/Reality/Socks5)
#   - xray    (或 xray-argo): 运行 Xray 经典版 (支持 VLESS/VMess/Trojan)
MODE=singbox

# 2. 核心基础配置
# 订阅 HTTP 服务监听端口 (默认 3000)
PORT=3000
# 节点订阅路径 (默认 sub，访问地址即: http://IP:PORT/sub)
SUB_PATH=sub
# 节点 UUID (建议自定义生成，留空使用内置随机 UUID)
UUID=
# 节点名称前缀 (如: Docker-Node)
NAME=MyTunnel
# 运行临时目录 (默认 .cache)
FILE_PATH=.cache

# 3. Sing-box 专属端口配置 (仅在 MODE=singbox 且需要直连/多端口映射时生效)
# Hysteria2 端口 (默认 10203)
HY2_PORT=10203
# Reality 端口 (默认 10203)
REALITY_PORT=10203
# TUIC 端口 (留空不启用)
TUIC_PORT=
# Socks5 端口 (留空不启用)
S5_PORT=
# AnyTLS 端口 (留空不启用)
ANYTLS_PORT=
# AnyReality 端口 (留空不启用)
ANYREALITY_PORT=

# 4. Cloudflare Argo 隧道配置
# Argo 固定隧道域名 (留空则自动启用临时 quick tunnel)
ARGO_DOMAIN=
# Argo 固定隧道 Token 或 JSON 凭证 (留空则自动启用临时 quick tunnel)
ARGO_AUTH=
# Argo 隧道本地监听端口 (默认 8001，固定隧道需与 Cloudflare 后台一致)
ARGO_PORT=8001
# 是否禁用 Argo 隧道 (true 禁用，false 开启，默认 false)
DISABLE_ARGO=false

# 5. Cloudflare 优选 IP 与端口配置
# 优选域名或优选 IP (例如: time.is / saas.sin.fan / spring.io)
CFIP=time.is
# 优选端口 (默认 443)
CFPORT=443

# 6. 哪吒探针配置 (可选，不配置则不启动探针)
# 哪吒服务端域名/IP (v1 格式: nz.xxx.com:8008, v0 格式: nz.xxx.com)
NEZHA_SERVER=
# 哪吒客户端通信端口 (v1 请留空; v0 填端口，填 443/8443/2096/2087/2083/2053 等开启 TLS)
NEZHA_PORT=
# 哪吒密钥 (v1 的 NZ_CLIENT_SECRET 或 v0 的 agent 密钥)
NEZHA_KEY=

# 7. 订阅上传与自动访问保活 (可选)
# 节点/订阅自动上传服务地址 (例如: https://merge.example.com)
UPLOAD_URL=
# 本项目的外部访问域名/URL (用于保活或订阅上传，例如: https://my-app.example.com)
PROJECT_URL=
# 是否开启自动访问保活 (true 开启，false 关闭，默认 false；需同时配置 PROJECT_URL)
AUTO_ACCESS=false

# 8. Telegram 节点推送 (可选，两者同时填写才会推送)
CHAT_ID=
BOT_TOKEN=

